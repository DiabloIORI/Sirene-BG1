// BANTERS

// Baeloth

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneBaeloth1","MYAREA",0)
	Switch("C02SireneBaeloth1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Baeloth",~太有意思了！一个魔裔的战士，去信那种哄蠢货的教！要是当年你能在我的黑坑里打，我肯拿出什么来换啊。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneBaeloth1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~你这胡言乱语我听不懂，卓尔。说清楚，不然就别开口。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneBaeloth1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Baeloth",~可惜那家体面的场子如今已不归我了。你当角斗士的身价，本可以顶到榜首！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneBaeloth1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我怀疑你根本听不见我。伊尔梅特才知道我为什么还在听这些。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneBaeloth1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Baeloth",~也许我可以重新来过。对……可现在，我上哪儿找个纳巴苏魔来谈笔便宜的买卖……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneBaeloth1","MYAREA",-1)
END

// Corwin

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneCorwin1","MYAREA",0)
	Switch("C02SireneCorwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("CORWIN",~我很意外您能全心全意过这样的日子，女士。您没有家人么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~据我所知，没有。我出生不久就被丢弃了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("CORWIN",~我明白了。看来要弄懂您的职分是什么样，是没指望的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~真有那么难么，科尔温？你对拳会的职分，和我的并无不同。我们都是守护者，只是我们所选要护的人或许不同。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",8)
	SetGlobal("C02SireneCorwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("CORWIN",~不一样。我对我的女儿有责任，比对拳会的还重。自从罗玛出生，我做的一切都是为了给她一个更明亮的将来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",8)
	SetGlobal("C02SireneCorwin1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~你觉得这职分就不如我的高尚么？并非如此，科尔温。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("CORWIN",~我不是那个意思。我——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02SireneCorwin1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("CORWIN",~*叹气* 算了。这不值得谈。抱歉浪费你的时间。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02SireneCorwin1","MYAREA",-1)
END

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneCorwin2","MYAREA",0)
	Switch("C02SireneCorwin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("CORWIN",~抱歉先前我把话截得那样突兀。那是失礼。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~我没放在心上，科尔温；只是我不知你的职分竟这般困扰你。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("CORWIN",~本来不困扰，直到罗玛进了这局。如今我每天都得提心吊胆，怕要在对家国的爱和对女儿的爱之间做选择。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~恕我，科尔温。我原以为我们何其相似，是我糊涂了。显然我还有许多不懂。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("CORWIN",~不，没事。年轻些的我，会想成为你这样的人——为职分把命押上去。可我不能死，有罗玛在就不行。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("CORWIN",~真该死。有时候我也想，当初不肯把她交给更能照料她的人，是不是我自私。倒不是后悔……我从没后悔过。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~我明白，我的朋友。不爱自己孩子胜过一切的，才是不配的父母。你没有错。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02SireneCorwin2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("CORWIN",~但愿我能像你那样信得这么实。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneCorwin2","MYAREA",-1)
END

// Dorn

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneDornWounded1","MYAREA",0)
	Switch("C02SireneDornWounded1","MYAREA")
THEN
RESPONSE #1
	MoveToObject("DORN")
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02SireneDornWounded1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("DORN",~把手拿开，女人。我不需要治疗。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDornWounded1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Sirene",~你若宁可就这么流血而死，恶徒，那我乐意成全。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDornWounded1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("DORN",~要像你这样的弱才配因为这点小伤失血而死。我不是弱才。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDornWounded1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Sirene",~你的傲慢会要你的命，魔物。我只盼那日子早些来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDornWounded1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("DORN",~真正傲慢的是你，丫头，竟然以为自己能把周围所有人的伤都揽上身。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDornWounded1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("DORN",~你的痛会把你压垮，直到你那瘦弱的身躯再也撑不住；到那时，你身上要受无数处伤的苦。你会——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDornWounded1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~够了！我不再在你身上费力气。我还有同伴要照料。~)
	ActionOverride("C0Sirene",ForceSpell("DORN",PALADIN_LAY_ON_HANDS))
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",4)
	SetGlobal("C02SireneDornWounded1","MYAREA",-1)
END

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneDorn1","MYAREA",0)
	Switch("C02SireneDorn1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dorn",~说吧，圣武士。去侍奉一位什么都不给、却要你为弱者忍受苦痛的神，能得着什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~只有你这种人，才会把信仰看成不过一场交易，恶徒。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dorn",~信自己的苦痛是为了什么更大的因由而该受着——这幻想倒有趣。痛是软弱；认了它，更是。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~那就说吧，多恩。除了力量，你真正想要的是什么？你的恶魔给了你什么，值得这般不近人情？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dorn",~别以为我的服侍是安逸舒坦的，女人。这一点上，我们倒很相似。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~什么？你疯了不成？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Dorn",~你和我一样——都是某个更大力量的棋子。我们都以血与屠戮，做主人脚下的狗。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~我们*半点*也不像。你连暗示都不许。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",80)
RESPONSE #70
	DisplayStringHead("Dorn",~确实。我远比你所能企望的更强。这差异够了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneDorn2","MYAREA",0)
	Switch("C02SireneDorn2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dorn",~你那点力量都被你的拘束糟蹋了，小鬼。别弃你的血——拥抱它！你若肯，也许还能与我的本事比肩。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02SireneDorn2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~别想用你那毒话诱我。这话我听过，我能回的只有刀锋。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dorn",~这么浪费天分。你是你血液的耻辱，女人。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~也不比你是你身上那点人性的耻辱更多，多恩。要不是我看你在黑暗里醉得太深、找不着路，我还会劝你去寻光。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dorn",~光？蠢女人，你忘了光是我们的敌人么？那正是唯一让我们还算是同盟的东西。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~是，正是。可一旦光熄了，我就要叫你再不能活着去害别人。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDorn2","MYAREA",-1)
END

// Dynaheir

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneDynaheir1","MYAREA",0)
	Switch("C02SireneDynaheir1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dynaheir",~你的剑技不凡，塞琳。论臂力你或许不及明斯克，可你的路数自有一种……优雅。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~多谢夸奖，狄娜希尔女士。不过若说优雅，战场上之外，我可不敢与你相比。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dynaheir",~我从只照我所见说真话。不过……这还不是全部。我虽不通战技之道，却能清楚看见你出招时有几分……迟疑。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~啊……那个么，是……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dynaheir",~你怕杀人么，塞琳？我倒以为，这对一位信仰的战士来说，是不相称的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~*叹气* 是。说出来惭愧，可我确实怕，尽管练了这么多年。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Dynaheir",~我看这话题叫你为难。我不再问了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~……多谢，女士。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneDynaheir2","MYAREA",0)
	Switch("C02SireneDynaheir2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Dynaheir",~上回我们说话，谈到你不愿杀人。若不介意，可否再回到这个话题？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~是，我想可以，狄娜希尔女士。你问吧。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Dynaheir",~那我问你——若你不愿夺去另一个活物的性命，又为何走圣武士这条路？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~您……您是在疑我么，女士？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Dynaheir",~不，我不是那个意思。可你在治疗上的天分不凡。你本可以做你信仰的女祭司，全然避开战阵。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~*叹气* 我自己也想过许多回……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Dynaheir",~那你为何还留在这条你自己厌弃的路上？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~我不知道。也许我血里就有嗜杀的一面，正如它也令我厌恶。也许这就是我想护别人不受苦的方式。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Dynaheir",~也许两者皆是。我觉着你心里乱。我请你想想，你何以仍愿留在战场，以及那是否真是你该成为的样子。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneDynaheir2","MYAREA",-1)
END

// Edwin

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneEdwin1","MYAREA",0)
	Switch("C02SireneEdwin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Edwin",~说说看，我们走到哪儿都得拖着这个道貌岸然的提夫林，究竟有什么必要，<CHARNAME>。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~我做了什么惹你不快，法师？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Edwin",~做了什么？！你做什么都惹我不快，小鬼！你像个疯兽似的往敌人身上扑！你像只烦人的苍蝇到处乱窜，还指望我怎么瞄准火球？！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",8)
	SetGlobal("C02SireneEdwin1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我在战阵里的位置，可从没妨碍过你乱丢法术。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Edwin",~何等的屈辱！你耽误我的法力，也就耽误了我在这场战争里的价值，而你半点不觉得羞耻！我竟得因为你收着法术！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~你若非得如此，便使出全力吧，法师。也许我会觉出分别；只是宁可让我来受这与你同行的后果，也别落到同伴身上。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneEdwin2","MYAREA",0)
	Switch("C02SireneEdwin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Edwin",~提夫林，你背的那柄剑，经我法术鉴定，有个……很有意思的结果。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~这柄剑？我背了两年。它确是附了法……可也不比我们手里别的兵器更甚。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Edwin",~这不过是简单头脑得出的结论。拿来，让我验一验。也许它还有未挖出的秘密。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我不建议那样——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",40)
RESPONSE #40
	MoveToObject("C0Sirene")
	DisplayStringHead("Edwin",~是，是，随你怎么说，提夫林，现在拿来，然后——呃啊！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",1)
	SetGlobal("C02SireneEdwin2","MYAREA",50)
RESPONSE #50
	ApplyDamagePercent("Edwin",1,FIRE)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Edwin",~剑袭击了我！这是什么把戏，提夫林？！你怎不想着先提醒我？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~你没给我机会。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Edwin",~呃……这事我记下了，记住我的话。你的脸我记住了，那柄剑也是。（总有一天……总有一天……）~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneEdwin2","MYAREA",-1)
END

// Glint

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneGlint1","MYAREA",0)
	Switch("C02SireneGlint1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Glint",~那么，呃……塞琳。你是爱狗还是爱猫？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~恕我，格林特，不过……你这话什么意思？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Glint",~你知道的，狗还是猫？你更喜欢哪个？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我……从没想过这个。狗吧，我想；不过我也不排斥猫。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Glint",~当真？我可想不到。你的眼睛让我想起我亲爱的老姑妈那只猫魔宠。她是个幻术师，你瞧。我是说我姑妈，不是说那猫。不过仔细想起来——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~*叹气* 恕我打断，格林特，这话有要紧处么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Glint",~嗯，有的，我几乎可以肯定有，只是……唉，我忘了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~*叹气*~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneGlint2","MYAREA",0)
	Switch("C02SireneGlint2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Glint",~我一直在脑子里翻找我要问你什么，塞琳，真是使劲在翻，可是……斗篷影在上，我就是想不起来。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~这可……真遗憾？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Glint",~算了，大概也没那么要紧。那么，你究竟*为什么*喜欢狗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~你不赞成？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Glint",~不，一点也不，我个人就爱狗。连凶的也爱，虽说它们肯定不爱我。总之，你究竟*为什么*喜欢狗？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~我家乡神殿里有一位瞎眼的祭司，靠一条猎犬给他引路。他年老健忘，常忘了喂他那伙伴。我就替他喂。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Glint",~哎呀，这可真是件善事，我自己都得这么说。请继续说。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~可惜再没什么好说的了……我喜欢那头牲口，因为它不像旁人那样怕我。在我孤单的童年里，它也许是我唯一真正的朋友。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Glint",~嗯，我自然看得出，那样的情谊是怎么生出来的。请继续说！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",90)
RESPONSE #90
	DisplayStringHead("C0Sirene",~那位瞎眼祭司过世后，那狗还留在神殿；直到两年后，一支路过的商队收留了它——队里有个瞎眼的男孩。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",100)
RESPONSE #100
	DisplayStringHead("Glint",~这真叫人难受。那你后来再没见过它？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",110)
RESPONSE #110
	DisplayStringHead("C0Sirene",~没有；不过它去了一个真正需要它的人身边，我也就安心了。这够解你的好奇了么，格林特？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",120)
RESPONSE #120
	DisplayStringHead("Glint",~哦，够了够了，绝对够了。下回我跟你讲我姑妈那只猫，讲它怎么——算了，这会儿先不扫兴。走吧！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneGlint2","MYAREA",-1)
END

// Jaheira

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneJaheira1","MYAREA",0)
	Switch("C02SireneJaheira1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Jaheira",~当心脚下，塞琳。你的甲和斗篷太亮，我们在谁眼里都显眼。这上头你不必再加上动静。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~是……你说得对，贾希拉。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Jaheira",~你想过换身装束么？我们要走的是敌境，穿那样的颜色，对我们所有人都是险。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我很抱歉，可是……我也没什么法子。甲是必须的，白斗篷是我信仰的表记。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Jaheira",~证明信仰的法子有的是，不必挂在身上到处显摆，孩子。先收起来，我给你另做一件更实用的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~我想这也是必需。那好，贾希拉。多谢。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Jaheira",~好。现在，我只需找些合适的叶子……~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneJaheira2","MYAREA",0)
	Switch("C02SireneJaheira2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Jaheira",~斗篷怎么样，孩子？尺寸可对，夜里够暖么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~是，都好。我承认我意外……我没想到叶子编的斗篷能有这般舒适。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Jaheira",~做它的时候用了几分德鲁伊法术，不过你觉着的舒适，多半还是出自手工。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~是，我感觉得到。我没想到你有这样本事，贾希拉。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Jaheira",~有些本事是被需要逼出来的。西凡纳斯知道，没有我，卡立德连一天都照料不好自己。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Jaheira",~我们独处的时候，我也给他做了一件。可惜围城那阵，他好像非把它当柴烧了不可，诸如此类。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~那不如把这件给他吧。他比我更配得。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Jaheira",~胡说，留着。不然你准又穿回那件不实用的白斗篷。等这一切完了，我再给他另做一件。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneJaheira2","MYAREA",-1)
END

// Khalid

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneKhalid1","MYAREA",0)
	Switch("C02SireneKhalid1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Sirene",~卡立德，你可有什么需要？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Khalid",~没——没有，我的朋友。我挺——挺好的。你去照看<CHARNAME>吧。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Sirene",~<CHARNAME>已经得到了我能给<PRO_HIMHER>的一切支持。我更愿意确保你安好。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Khalid",~真——真的，我没事。你为什么这么惦记我？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Sirene",~只是你当初在桥堡围城时那样拼命……我想那或许耗了你不少。我盼着能帮上什么。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Khalid",~哦，你——你不必担心。我比看上去要——要结实。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~不——不，我不是要疑你这一点——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Khalid",~这——这常常很难看出来，我知道。（紧张地笑）~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Sirene",~你是在逗我，是不是？（笑）那看来你是真好了。我很高兴。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneKhalid2","MYAREA",0)
	Switch("C02SireneKhalid2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Khalid",~我——我得说，打仗时你站在我们这一边，叫——叫我有底气。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~你……一定是弄错了，卡立德。有些圣武士能驱除旁人的恐惧，可我没有这力量。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Khalid",~不——不是法术上的意思。你只是那样……在战场上毫——毫无畏惧，这叫人振奋。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~这话不对，卡立德。我和旁人一样有恐惧，尤其在战阵里。一想到要打倒一个活人，我就满心惶恐。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Khalid",~可——可我从没见你从战场上逃开。哪怕你恨——恨透了杀另一个人的念头，只要我们哪个有了危险，你从——从不退缩。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~是，可那是因为我若为一个因由舍了命，也没多少可失的。你不一样，卡立德。你有贾希拉，还有<CHARNAME>。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Khalid",~这——这倒是，可你这么说……我反倒担——担心起你来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~不必。我早就认了，我的信条会带我去死，卡立德。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Khalid",~可——可你还这么年轻。别——别这么轻易就想着把命舍出去。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneKhalid2","MYAREA",-1)
END

// M'khiin

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneMkhiin1","MYAREA",0)
	Switch("C02SireneMkhiin1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Sirene",~你信奉哪一位神么，姆基恩？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02SireneMkhiin1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Mkhiin",~不知道。我信他们存在。可我从没怎么待见过他们。一群贪心的杂种，一味索要，从不给予。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Sirene",~并非所有的神都是那样……不过我承认，我未曾有你这番见识。你们部族的神是哪一位？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin1","MYAREA",40)
RESPONSE #30
	DisplayStringHead("Mkhiin",~玛格鲁比耶特。地精的战神。我从来想不通，去拜一个要你打一辈子仗的神有什么意思。别的地精怕他。我不怕。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin1","MYAREA",50)
RESPONSE #40
	DisplayStringHead("C0Sirene",~当真？那你比我认得的许多男人都勇。因惧怕而去追随一位恶神的，实在太多了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin1","MYAREA",60)
	DisplayStringHead("Mkhiin",~地精都是孬种。谁最强就跟谁，追不上我们的就往死里揍。我们的神也一样。~)
RESPONSE #50
	DisplayStringHead("C0Sirene",~你走萨满这条路，就是为了这个？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin1","MYAREA",70)
RESPONSE #60
	DisplayStringHead("Mkhiin",~精魂更好。我一召唤，精魂就应，从不索要。它们值得听。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneMkhiin2","MYAREA",0)
	Switch("C02SireneMkhiin2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Mkhiin",~上回打的时候，你故意挨了一下。蠢招。本来躲得开的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~我别无选择。要么那样，要么让你丢一条胳膊。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Mkhiin",~我比看上去硬。也不见你当真在乎。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我当真在乎，就这么难信么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Mkhiin",~说不上。长腿的我一个都不信，他们个个都想杀我。你我还说不准。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMkhiin2","MYAREA",-1)
END

// Minsc

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneMinsc1","MYAREA",0)
	Switch("C02SireneMinsc1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Minsc",~我的朋友塞琳，这么娇小的一位女士，竟使这么大一柄剑！你若再长些，只怕背的剑比明斯克还重，哈！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~多谢，明斯克；只是我并不像你想的那么强。我只是……学会了怎样把力气用得恰当。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Minsc",~明斯克的叔叔也说过一样的话。他告诉明斯克：“真正的战士，会用身上每一寸。”所以明斯克学会了拿头和脚当兵器，去砸邪恶的脑壳。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~确实，你力气大，明斯克，只是……我想那话不是这般字面意思。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Minsc",~狄娜希尔也这么跟我说过。不过她也说，只要明斯克把事办好，想用身上哪一部分都行。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Dynaheir",~明斯克！你说话该当心些，免得我们的朋友听岔了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneMinsc2","MYAREA",0)
	Switch("C02SireneMinsc2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Minsc",~明斯克糊涂了。塞琳说话做派几乎和狄娜希尔一样优雅，可她又是个跟明斯克一样威猛的战士！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~我是护民的人，明斯克。你还指望我是什么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Minsc",~布布觉得，你也许有那本事，能从指尖召出火来，像狄娜希尔那样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~你也许不算全错，明斯克。魔法很可能就在我血里，只是我从没试过打开藏在我体内的那些秘密。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Minsc",~布布很会藏。也许他能帮上忙。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~啊……不，明斯克。我说的不是那种藏。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Minsc",~啊哈！那你说的必定是……呃，比喻的意思。这是布布教的词。他说狄娜希尔很通这些。我们去问她。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Dynaheir",~明斯克……我想你缠着我们的同伴够久了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneMinsc2","MYAREA",-1)
END

// Neera

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneNeera1","MYAREA",0)
	Switch("C02SireneNeera1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Neera",~啊！你要把我逼疯了！我发誓，阿多伊，我要是知道你人在哪儿，我立刻就去找你，把你那脖子拧断，你听明白了就——~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~呃……妮拉？你要人帮忙么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Neera",~不要！呃，抱歉。我是说，不用。多谢了，不过我怀疑你也帮不上什么——密斯特拉在上，你就不能安静一小会儿？！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~真的，若有什么我能做的，你只管开口。我看得出这事叫你难受。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Neera",~难受都不足以形容。你若真想帮忙，塞琳，拿把刀来——把他那臭脑袋劈开，该死的！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Neera",~……呃，我是说我自己的脑袋。那该死的嗓门把我带偏了。谢天谢地，他总算安静下来了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~妮拉，你不是当真……是吧？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Neera",~唉，我是当笑话说的，行不行？我知道很糟，可我总得*做点什么*，好让自己忘了他还在。有那噪声，我连想事都想不直。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Neera",~你想帮忙？咱们可以来场女人之间的闲话。好几个礼拜我除了这家伙没人可说话，我都快疯了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",90)
RESPONSE #90
	DisplayStringHead("C0Sirene",~呃……当然，妮拉。若这样能帮到你。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",100)
RESPONSE #100
	DisplayStringHead("Neera",~多谢。等等，不，还是改天吧。哦不好，他又回来了。我干脆到那边去，免得我的尖叫把你喊聋。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneNeera2","MYAREA",0)
	Switch("C02SireneNeera2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Neera",~嗨。有空么，塞琳？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~当然。你需要什么，妮拉？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Neera",~我只是想说声谢谢。谢你陪我什么的。希望我没把你耳朵说坏，也别是喊坏。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~你当然没有，妮拉。我随时都在。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Neera",~不过我好奇。你怎么能一直这么有耐性、这么体谅人？多半时候，人家看我像看疯子，或者像看一团随时炸开的咒火。你倒不这样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Neera",~等等，别告诉我。是因为圣武士那一套吧？就算你不愿意，也得这么做？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~这确实是我该做的，不错；可我确实喜欢和你说话，妮拉。我也不因你的魔法怪你……我们里头，真能自己选择成为什么的，没几个。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Neera",~唉，这番话说得我心里热乎乎的。有你这个朋友，我很高兴，塞琳。所以万一我不小心把你烤焦了，我会格外难过——算了。别坏了这气氛。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneNeera2","MYAREA",-1)
END

// Rasaad

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneRasaad1","MYAREA",0)
	Switch("C02SireneRasaad1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("RASAAD",~我们在博德之门一起帮难民的时候，没怎么说过话。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02SireneRasaad1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~是，没怎么说过。我当然留意到你，只是……你总像心不在焉，沉在自己的思绪里。打断你几乎像是一种罪过。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("RASAAD",~我确是如此。近来冥想于我，已不容易。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~什么事这样困扰你，拉萨德？你是我见过最坚韧的人之一。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("RASAAD",~我为我的苏伦同道担心。纵然近来我疏于照料他们，若真出了事，他们断不会不给我征兆就消失。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~原来如此……可你不该去找他们么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("RASAAD",~不。眼下这是更迫近、更显见的威胁。我若得着任何关于我兄弟下落的线索，会在恰当的时机去找他们。此刻，这里需要我。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~但愿我能为你出点力，拉萨德。无论如何，有你这样的人同行，我很高兴。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneRasaad2","MYAREA",0)
	Switch("C02SireneRasaad2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("C0Sirene",~我见识战阵的年头不多，却从没见过像你这样打的人，拉萨德。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("RASAAD",~你抬举我了，朋友；其实并无出奇之处。我只会日光魂武僧人人皆知的那些根基功夫。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Sirene",~恕我直言，这我难以相信。你的招式看来那样……繁复。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("RASAAD",~在外人看来或许如此，塞琳，可练起来要容易得多。只要你有年头下功夫，连你也到得了同样的境界。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Sirene",~我？当真？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("RASAAD",~是。你的打法与我的并无不同。你不靠蛮力，所长在灵巧与耐性，等着最恰当的时机出手。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~你竟能从我的路数里看出这么多？你真是一名了不起的武者，拉萨德。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("RASAAD",~等我们有空，不妨对练一个时辰，彼此学学对方的技法。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("C0Sirene",~我很愿意。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneRasaad2","MYAREA",-1)
END

// Safana

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneSafana1","MYAREA",0)
	Switch("C02SireneSafana1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("SAFANA",~别往坏处想，亲爱的，可你这身甲实在过时得厉害。穿这样不衬人的衣裳，你还指望招来男人？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~我穿甲是为了护身，不是像你那样把自己露出来，萨法娜。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("SAFANA",~哎呀，真无礼。我好心好意给你一句贴心的劝告，女人对女人，换来的却是这般刺话！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~*叹气* 不，我该道歉；只是……我不确定你是不是在嘲弄我。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("SAFANA",~哦，得了吧。我没那么狠心。再说，我要真不在乎，就闭嘴不语，让男人们都来找我了。你不也这么想？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~我……想你说得对。可我的甲实用，我也更愿意这样。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("SAFANA",~我还破例大方了一回呢。我甚至想好了你可以怎么……改改你的装束。随你高兴吧，亲爱的。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneSafana2","MYAREA",0)
	Switch("C02SireneSafana2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("SAFANA",~那么，你对女人也有意思，嗯？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~与你何干？我不认为我曾公开表露过我的偏好。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("SAFANA",~哦，这种事我有眼力，塞琳。比方说，我逮着你往我这儿看了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我没有那样做。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("SAFANA",~圣武士不是有条规矩，不许当面说谎么？我不瞎，亲爱的；可这样偷偷摸摸地瞟，久了也让人烦。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~那都无关紧要。不论我外在怎样看你，我也不会考虑与你这般不可信的人有任何牵扯。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("SAFANA",~我可不吃亏，亲爱的。你身上没有我要的东西。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneSafana2","MYAREA",-1)
END

// Viconia

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneViconia1","MYAREA",0)
	Switch("C02SireneViconia1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Viconia",~你似乎不像我预料的那样排斥我在场。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02SireneViconia1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~你想说什么，莎尔信徒？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Viconia",~我上到地表以来，见过不少虔诚又粗野的蠢货。他们没一个肯让人说完两句就拔刀。你是个奇怪的例外。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我不因一个人是什么而评判他，维康妮亚，只看他选择成为什么。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Viconia",~当然。你是个……“de'rendalhar”。魔裔所生的东西。在里维尔当中，你我该是同盟。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~我们是同盟，但只是权宜的同盟。我不因你是卓尔而怪你，可我也不会与一个莎尔的信徒结盟。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Viconia",~你们地表的众神里，只有夜歌者肯接纳我。莎尔让我看见力量的价值。我亟待之时，你们那些“仁慈”的神在哪儿？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~也许正是你那颗黑心把他们挡在了外头。我不再与你废话。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneViconia2","MYAREA",0)
	Switch("C02SireneViconia2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Viconia",~说吧，de'rendalhar，有多少人在你给他们治过伤之后，明白你是什么东西，就朝你吐口水？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",7)
	SetGlobal("C02SireneViconia2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~很多，莎尔信徒；可也有别的一些人，在我治好他们之后，恐惧就消了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Viconia",~可一有机会就向你举刀的，肯定比那些多。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~我若放任自己被拒的恐惧支配，就永远不会遇到<CHARNAME>这样的朋友。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",5)
	SetGlobal("C02SireneViconia2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Viconia",~你这份天真的乐观叫我恶心。你要是在幽暗地域，活不过一天。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~也许你该回头看看自己，维康妮亚，记住这里不是幽暗地域。不信任只会叫你失掉本可能有的情谊。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Viconia",~朋友不过是拿来对付你的兵器。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~除非你不给他们应得的信任。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneViconia2","MYAREA",-1)
END

// Voghiln

// talk 1

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneVoghiln1","MYAREA",0)
	Switch("C02SireneVoghiln1","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Voghiln",~喂，我美丽的战争女士！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",10)
RESPONSE #10
	DisplayStringHead("Voghiln",~……呃，女士？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",20)
RESPONSE #20
	DisplayStringHead("C0Sirene",~哦！什——什么事，沃吉尔恩？你需要帮忙么？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",30)
RESPONSE #30
	DisplayStringHead("Voghiln",~啊，女士终于回头了！不，我什么都不需要。我只想看看你美丽的脸，请你笑一笑，仅此而已。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",40)
RESPONSE #40
	DisplayStringHead("C0Sirene",~哦，我……我明白了。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",50)
RESPONSE #50
	DisplayStringHead("Voghiln",~可说真的，塞琳夫人，你真是独一份。沃吉尔恩受过许多姑娘的青睐，也挨过她们的箭，可这还是头一回，沃吉尔恩得到的回应冷到被人彻底无视。你伤了我，女士！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",60)
RESPONSE #60
	DisplayStringHead("C0Sirene",~我——若我的态度冒犯了你，沃吉尔恩，那我谦卑地请你原谅。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",70)
RESPONSE #70
	DisplayStringHead("Voghiln",~哈！你这样戏弄沃吉尔恩的情意，真是聪明极了，女士；可我向你发誓，我终会攻破你那冰冷的防线！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln1","MYAREA",-1)
END

// talk 2

IF
	InMyArea(Player1)
	!ActuallyInCombat()
	!GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
	GlobalGT("C02SireneVoghiln2","MYAREA",0)
	Switch("C02SireneVoghiln2","MYAREA")
THEN
RESPONSE #1
	DisplayStringHead("Voghiln",~啊，美丽的塞琳女士！真是个美好的<DAYNIGHT>，可不是？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",10)
RESPONSE #10
	DisplayStringHead("C0Sirene",~是，确实，沃吉尔恩。你今天气色不错。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",20)
RESPONSE #20
	DisplayStringHead("Voghiln",~是，我是不错，怎么不呢？没有什么比活着更快乐——喝酒、宴饮，再去求娶最美的姑娘！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",30)
RESPONSE #30
	DisplayStringHead("C0Sirene",~你对人生有一种无拘无束的看法，我的朋友。某种意义上，我钦佩这一点。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",40)
RESPONSE #40
	DisplayStringHead("Voghiln",~不过闲话我就免了，女士。我问你：你觉得老沃吉尔恩怎么样，嗯？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",50)
RESPONSE #50
	DisplayStringHead("C0Sirene",~我觉得你怎么样，沃吉尔恩？嗯……我认为你是个好人。你的战歌也……在战场上很能鼓劲。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",60)
RESPONSE #60
	DisplayStringHead("Voghiln",~哈哈！原来打动你心的是音乐！那沃吉尔恩就为你吟一段小曲，如何？~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",70)
RESPONSE #70
	DisplayStringHead("C0Sirene",~你还会唱别的曲子么，沃吉尔恩？我倒想听听。~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",80)
RESPONSE #80
	DisplayStringHead("Voghiln",~好好听，女士，让沃吉尔恩的诸多才艺把你迷住吧！~)
	SetGlobalTimer("BD_BANTER_DELAY","MYAREA",6)
	SetGlobal("C02SireneVoghiln2","MYAREA",-1)
END

IF
  !GlobalTimerNotExpired("BD_BANTER_DELAY","MYAREA")
!RealGlobalTimerNotExpired("C02_BANTER_DELAY","GLOBAL")
THEN
  RESPONSE #100
    SetAreaScript("",GENERAL)
END