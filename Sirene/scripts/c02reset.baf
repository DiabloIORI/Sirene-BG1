        SetPlayerSound(Myself,~好。~ [C0SR028],SELECT_ACTION2)
        SetPlayerSound(Myself,~是，我会的。~ [C0SR029],SELECT_ACTION3)
        SetPlayerSound(Myself,~你的裁决到了！~ [C0SR035],CRITICAL_HIT)
        SetPlayerSound(Myself,~呃！~ [C0SR036],CRITICAL_MISS)
