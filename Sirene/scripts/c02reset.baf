        SetPlayerSound(Myself,~我不能认同这样的行径。~ [C0SR002],UNHAPPY_ANNOYED)
        SetPlayerSound(Myself,~对你这样的人，已没剩下多少仁慈。~ [C0SR003],UNHAPPY_SERIOUS)
        SetPlayerSound(Myself,~我不会再为这桩邪恶的事业流一滴血。~ [C0SR004],UNHAPPY_BREAKING_POINT)
        SetPlayerSound(Myself,~我配不上这份荣耀，但既已如此，我不会负你。~ [C0SR005],LEADER)
        SetPlayerSound(Myself,~我担心倦怠之时难以行事。我们可否歇一歇？~ [C0SR006],TIRED)
        SetPlayerSound(Myself,~我们总该把时间用在更合适的事上。~ [C0SR007],BORED)
        SetPlayerSound(Myself,~我不会退缩！~ [C0SR008],BATTLE_CRY1) 
        SetPlayerSound(Myself,~仁慈的时候已经过去了！~ [C0SR009],BATTLE_CRY2) 
        SetPlayerSound(Myself,~恕我不得不如此！~ [C0SR010],BATTLE_CRY3)      
        SetPlayerSound(Myself,~以伊尔梅特之名！~ [C0SR011a],BATTLE_CRY4) 
        SetPlayerSound(Myself,~为哭泣之神！~ [C0SR012a],BATTLE_CRY5)   
        SetPlayerSound(Myself,~呃！~ [C0SR013],DAMAGE)
        SetPlayerSound(Myself,~伊尔梅特，带我走吧……~ [C0SR014a],DYING)
        SetPlayerSound(Myself,~只要我还站着，你休想再伤别人！~ [C0SR015],HURT)
        SetPlayerSound(Myself,~森林的静谧总令我安心。~ [C0SR016],AREA_FOREST)
        SetPlayerSound(Myself,~与朋友同行，走在街上也轻松些。~ [C0SR017],AREA_CITY)
        SetPlayerSound(Myself,~只要我们还在这是非之地，我就会一直警惕。~ [C0SR018],AREA_DUNGEON)
        SetPlayerSound(Myself,~阳光暖人。少有别的能给我更大的慰藉。~ [C0SR019],AREA_DAY)
        SetPlayerSound(Myself,~夜色不祥，可是……想到它掩住了我的真身，我反倒安然。~ [C0SR020],AREA_NIGHT)
        SetPlayerSound(Myself,~我在。~ [C0SR021],SELECT_COMMON1)
        SetPlayerSound(Myself,~要我做什么？~ [C0SR022],SELECT_COMMON2)
        SetPlayerSound(Myself,~随时待命。~ [C0SR023],SELECT_COMMON3)
        SetPlayerSound(Myself,~什么事？~ [C0SR024],SELECT_COMMON4)
        SetPlayerSound(Myself,~我在你身边。~ [C0SR025],SELECT_COMMON5)
        SetPlayerSound(Myself,~您要什么，尽管说。~ [C0SR026],SELECT_COMMON6)
