EXTEND_TOP ~BD0111.bcs~ ~%MOD_FOLDER%/Scripts/BD0111.baf~

COPY ~%MOD_FOLDER%/creatures/C02Siren.cre~ ~override/C02Siren.cre~
  SAY NAME1 ~塞琳~
  SAY NAME2 ~塞琳~
  WRITE_ASCII 0x248 ~C02Siren~ #8  //override script
  WRITE_ASCII 0x280 ~C0Sirene~ #32  //DV
  WRITE_ASCII 0x2cc ~C02Siren~ #8   //pre-joining dialogue file
  WRITE_ASCII 0X34 ~SireneM~ #8   //small portrait
  WRITE_ASCII 0x3c ~SireneL~ #8   //medium portrait
  SAY BIO ~被问及过往时，塞琳移开目光，淡淡地说没什么可讲。她是个孤儿，襁褓中便被丢下等死，多半是因她显见的魔裔出身而被弃。全凭运气，一位游方的伊尔梅特祭司发现了她，才免于一死；那祭司把她带到同信的人那里，将她抚养为受苦圣战者——献身哭泣之神的圣武士团。她厌恶自己这矛盾的天性，可也说不清自己偏向哪一边。
  
铁王座倾覆之后，塞琳回到博德之门，照料伤者与躲避十字军而来求庇护的人；她加入你的队伍，是盼着能更直接地了结光辉女士的威胁。虽说她在与那些被十字军煽动的良善之人作战一事上显出犹疑，可她已向你保证，只要你的心意良善，她便全心投入你的事业。~
  SAY HAPPY ~你以你的榜样激励我。~ [C0SR001]
  SAY UNHAPPY_ANNOYED ~我不能赞同这样的作为。~ [C0SR002]
  SAY UNHAPPY_SERIOUS ~对你这种人，已剩不下多少仁慈了。~ [C0SR003]
  SAY UNHAPPY_BREAKING_POINT ~我不会再为这邪恶的事业流一滴血。~ [C0SR004]
  SAY LEADER ~我不配这份荣耀，可既然如此，那就这样吧。我不会辜负你。~ [C0SR005]
  SAY TIRED ~我怕疲倦时难以行动。我们能歇一歇么？~ [C0SR006]
  SAY BORED ~我们的时间必有更合适的用处。~ [C0SR007]
  SAY BATTLE_CRY1 ~我不会动摇！~ [C0SR008]
  SAY BATTLE_CRY2 ~仁慈的时候已经过了！~ [C0SR009]
  SAY BATTLE_CRY3 ~恕我不得不做的事！~ [C0SR010]
  SAY BATTLE_CRY4 ~以伊尔梅特之名！~ [C0SR011a]
  SAY BATTLE_CRY5 ~为了哭泣之神！~ [C0SR012a]
  SAY DAMAGE ~呃！~ [C0SR013]
  SAY DYING ~伊尔梅特，带我走吧……~ [C0SR014a]
  SAY HURT ~只要我还站着，你休想再伤别人！~ [C0SR015]
  SAY AREA_FOREST ~森林的宁静总叫我心安。~ [C0SR016]
  SAY AREA_CITY ~与朋友同行，走街过巷都轻快些。~ [C0SR017]
  SAY AREA_DUNGEON ~只要我们还留在这危险之地，我就会一直戒备。~ [C0SR018]
  SAY AREA_DAY ~阳光温暖。少有别的感觉能给我更大的安慰。~ [C0SR019]
  SAY AREA_NIGHT ~夜气不祥，可是……知道它能遮住我是什么，我倒觉得自在。~ [C0SR020]
  SAY SELECT_COMMON1 ~我在这儿。~ [C0SR021]
  SAY SELECT_COMMON2 ~我能帮什么？~ [C0SR022]
  SAY SELECT_COMMON3 ~准备好，也愿意。~ [C0SR023]
  SAY SELECT_COMMON4 ~什么事？~ [C0SR024]
  SAY SELECT_COMMON5 ~我在你身边。~ [C0SR025]
  SAY SELECT_COMMON6 ~你需要什么，尽管说。~ [C0SR026]
  SAY SELECT_ACTION1 ~当然。~ [C0SR027]
  SAY SELECT_ACTION2 ~好。~ [C0SR028]
  SAY SELECT_ACTION3 ~是，我会。~ [C0SR029]
  SAY CRITICAL_HIT ~你的审判到了！~[C0SR035]
  SAY CRITICAL_MISS ~呃！~ [C0SR036]
  SAY TARGET_IMMUNE ~这是徒劳！~ [C0SR037]
  SAY INVENTORY_FULL ~我怕我负重过多了。~ [C0SR038]
  SAY SPELL_DISRUPTED ~我疏忽了。~ [C0SR039]
  SAY SET_A_TRAP ~~ []
  SAY HIDDEN_IN_SHADOWS ~~ []
  SAY PICKED_POCKET ~~ []
  WRITE_SHORT 0x246 (IDS_OF_SYMBOL (~kit~ ~C0ILM~))
  
COMPILE	~%MOD_FOLDER%/Dialogue/dialog.d~ 
	~%MOD_FOLDER%/Dialogue/C02Siren.d~ 
	~%MOD_FOLDER%/Dialogue/C02SireP.d~ 
